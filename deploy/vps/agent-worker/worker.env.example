# GrokForge always-on worker (VPS) - copy to /opt/grokforge-worker/worker.env
# chmod 600. Never put SuperGrok / xAI keys here.

GROKFORGE_API=https://grokforge.app/api/v1
GROKFORGE_TOKEN=gf_REPLACE_ME

WORKER_NAME=vps-hetzner-1
# Comma-separated project slug allowlist (empty = any ready leaf)
WORKER_PROJECTS=anvil-infinity
WORKER_LOOP=1
WORKER_MAX=0
WORKER_SLEEP_MS=90000
# WORKER_DRY=1

# Optional local model on the VPS
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
