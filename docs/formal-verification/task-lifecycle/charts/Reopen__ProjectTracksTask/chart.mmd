title: "GrokForge leaf task: claim, submit, review, accept"
---
stateDiagram-v2
  state "Legend" as legend {
    lg0: Open
    lg1: Claimed
    lg2: Submitted, in review
    lg3: Accepted, done
    lg4: Breaks ProjectTracksTask
    lg5: Path to the ProjectTracksTask bug
  }
  class lg0 blue
  class lg1 yellow
  class lg2 purple
  class lg3 teal
  class lg4 breaks
  class lg5 bugPath
  s0: Open
  s1: Claimed
  s2: Claimed #183; submit in progress
  s3: Submitted, in review
  s4: Submitted, in review #183; creator decision in progress
  s5: Accepted, done #183; creator decision in progress
  s6: Accepted, done
  s7: Open again, sent back for rework #183; project still marked complete
  [*] --> s0
  s0 --> s1: a builder claims the task
  s1 --> s2: a builder sends in work
  s2 --> s3: the submission is saved
  s3 --> s4: the creator opens the submission
  s4 --> s4: the creator accepts the submission
  s4 --> s5: the creator's accept marks the task accepted
  s5 --> s5: the author is paid reputation or the creator's review is saved
  s5 --> s6: the project status is recomputed
  s6 --> s7: the creator reopens the task for rework
  classDef breaks fill:#ffecee,stroke:#e72e3b,stroke-width:2.5px,color:#cd2834
  class s0 blue
  class s0 bugPath
