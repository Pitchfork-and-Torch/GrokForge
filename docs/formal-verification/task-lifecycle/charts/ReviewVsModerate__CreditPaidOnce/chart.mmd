---
title: "GrokForge leaf task: claim, submit, review, accept"
---
stateDiagram-v2
  state "Legend" as legend {
    lg0: Open
    lg1: Claimed
    lg2: Submitted, in review
    lg3: Accepted, done
    lg4: Breaks CreditPaidOnce
    lg5: Path to the CreditPaidOnce bug
  }
  class lg0 blue
  class lg1 yellow
  class lg2 purple
  class lg3 teal
  class lg4 breaks
  class lg5 bugPath
  s0: Open
  s1: Claimed
  s2: Claimed #183; submit in progress
  s3: Submitted, in review
  s4: Submitted, in review #183; peer review in progress
  s5: Submitted, in review #183; peer review + creator decision in progress
  s6: Accepted, done #183; peer review + creator decision in progress
  s7: Accepted, done #183; peer review + creator decision in progress #183; author paid twice
  [*] --> s0
  s0 --> s1: a builder claims the task
  s1 --> s2: a builder sends in work
  s2 --> s3: the submission is saved
  s3 --> s4: a peer reviewer opens the submission
  s4 --> s4: the peer review is saved or the review average is computed
  s4 --> s5: the creator opens the submission
  s5 --> s5: peer review accepts the submission
  s5 --> s6: peer review marks the task accepted
  s6 --> s6: the author is paid reputation or the creator accepts the submission or the creator's accept marks the task accepted
  s6 --> s7: the author is paid reputation
  classDef breaks fill:#ffecee,stroke:#e72e3b,stroke-width:2.5px,color:#cd2834
  class s0 blue
  class s0 bugPath
  class s1 yellow
  class s1 bugPath
  class s2 yellow
  class s2 bugPath
  class s3 purple
  class s3 bugPath
  class s4 purple
  class s4 bugPath
  class s5 purple
  class s5 bugPath
  class s6 teal
  class s6 bugPath
  class s7 teal
  class s7 breaks
  class s7 bugPath
