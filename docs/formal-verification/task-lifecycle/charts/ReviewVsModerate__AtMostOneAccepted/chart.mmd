---
title: "GrokForge leaf task: claim, submit, review, accept"
---
stateDiagram-v2
  state "Legend" as legend {
    lg0: Open
    lg1: Claimed
    lg2: Submitted, in review
    lg3: Breaks AtMostOneAccepted
    lg4: Path to the AtMostOneAccepted bug
  }
  class lg0 blue
  class lg1 yellow
  class lg2 purple
  class lg3 breaks
  class lg4 bugPath
  s0: Open
  s1: Claimed
  s2: Claimed #183; submit in progress
  s3: Submitted, in review
  s4: Submitted, in review #183; peer review in progress
  s5: Submitted, in review #183; peer review + creator decision in progress
  s6: Open #183; peer review + creator decision in progress
  s7: Claimed #183; peer review + creator decision in progress
  s8: Claimed #183; submit + peer review + creator decision in progress
  s9: Submitted, in review #183; peer review + creator decision in progress #183; two accepted deliverables
  [*] --> s0
  s0 --> s1: a builder claims the task
  s1 --> s2: a builder sends in work
  s2 --> s3: the submission is saved
  s3 --> s4: a peer reviewer opens the submission
  s4 --> s4: the peer review is saved or the review average is computed
  s4 --> s5: the creator opens the submission
  s5 --> s5: the creator rejects the submission or peer review accepts the submission or no reputation is paid [rejected] or the creator's review is saved
  s5 --> s6: the creator's reject reopens the task
  s6 --> s7: a builder claims the task
  s7 --> s8: a builder sends in work
  s8 --> s5: the submission is saved
  s5 --> s4: the project status is recomputed
  s5 --> s9: the creator accepts the submission
  classDef breaks fill:#ffecee,stroke:#e72e3b,stroke-width:2.5px,color:#cd2834
  class s0 blue
  class s0 bugPath
  class s1 yellow
  class s1 bugPath
  class s2 yellow
  class s2 bugPath
  class s3 purple
  class s3 bugPath
  class s4 purple
  class s4 bugPath
  class s5 purple
  class s5 bugPath
  class s6 blue
  class s6 bugPath
  class s7 yellow
  class s7 bugPath
  class s8 yellow
  class s8 bugPath
  class s9 purple
  class s9 breaks
  class s9 bugPath
