# Neon Postgres connection string (pooled recommended)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Auth.js
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-long-random-string"
AUTH_SECRET="same-as-NEXTAUTH_SECRET"

# Stripe (optional - demo donate works without these)
# With STRIPE_SECRET_KEY set, Donate opens Checkout; webhook credits pots
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Optional multi-instance rate limits (falls back to in-memory)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Comma-separated X handles for Founder badge
FOUNDER_HANDLES="SuddenlyJon"

# Optional webhook for high-signal project events
# Generic: POST JSON { type, title, body, href }
# Agent-email bridge (jonbailey-email /send): set FORMAT=agent-email
NOTIFY_WEBHOOK_URL=""
NOTIFY_WEBHOOK_TOKEN=""
NOTIFY_WEBHOOK_FORMAT=""
# Optional override recipient for agent-email format (else worker default to)
NOTIFY_EMAIL_TO=""

# Vercel Cron + manual GET/POST /api/cron/expire-claims
# Authorization: Bearer <CRON_SECRET>
CRON_SECRET=""

# Optional server-side xAI key for AI task decomposition + Grok Imagine banners
# Never request or store end-user SuperGrok / xAI credentials
XAI_API_KEY=""
XAI_MODEL="grok-3-mini"
# Banner images: grok-imagine-image (cheaper) or grok-imagine-image-quality
XAI_IMAGE_MODEL="grok-imagine-image"

# Optional Vercel Blob for durable banner storage (recommended in production)
# Without this, banners fall back to size-capped data URLs in Postgres
BLOB_READ_WRITE_TOKEN=""

# Real X (Twitter) OAuth 2.0 - developer.x.com User authentication
# Production callbacks:
#   https://grokforge.app/api/auth/callback/twitter
#   https://www.grokforge.app/api/auth/callback/twitter
# Local: http://localhost:3000/api/auth/callback/twitter
AUTH_TWITTER_ID=""
AUTH_TWITTER_SECRET=""
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"
# Production: leave unset or false. Local demos: true
ENABLE_DEMO_AUTH=""

# Optional GitHub OAuth - link accounts + fill githubHandle for artifacts
# Callback: https://grokforge.app/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Ship to GitHub (founder/admin auto-publish of sealed packages)
# Classic PAT or fine-grained token with admin:org repo create + contents write
# Never commit a real token. Empty in example only.
GITHUB_PUBLISH_TOKEN=""
GITHUB_PUBLISH_ORG="Pitchfork-and-Torch"

# Optional Stripe Price IDs ($1 units) for compute pots + match pool.
# When unset, Checkout uses dynamic price_data for the chosen USD amount.
STRIPE_PRICE_COMPUTE=""
STRIPE_PRICE_API_CREDITS=""
STRIPE_PRICE_SUPERGROK_SPONSOR=""
STRIPE_PRICE_MATCHING_POOL=""
STRIPE_PRICE_GENERAL=""

# X Money: deeplink (default) until official third-party API exists
# X_MONEY_API_MODE=native + X_MONEY_API_KEY only when X ships a real Money API
X_MONEY_API_MODE="deeplink"
X_MONEY_API_KEY=""
